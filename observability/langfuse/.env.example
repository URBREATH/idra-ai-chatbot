# Copy to .env and replace every value (e.g. `openssl rand -hex 32`).
# .env is git-ignored.
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=<random-hex-32>
SALT=<random-hex-32>
ENCRYPTION_KEY=<random-hex-32>   # exactly 64 hex chars
POSTGRES_PASSWORD=<random>
CLICKHOUSE_PASSWORD=<random>
MINIO_ROOT_PASSWORD=<random>
REDIS_AUTH=<random>

# Headless initialisation (org/project/keys/user created at first start)
LANGFUSE_INIT_ORG_ID=idra
LANGFUSE_INIT_ORG_NAME=Idra
LANGFUSE_INIT_PROJECT_ID=idra-ai-chatbot
LANGFUSE_INIT_PROJECT_NAME=Idra AI Chatbot
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-<random>
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-<random>
LANGFUSE_INIT_USER_EMAIL=admin@idra.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=<random>
