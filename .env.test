# variables related to application
PORT=3000
NODE_ENV=development
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=1h
ADMIN_TOKEN=my-admin-token

# variables related to mongodb
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=rag_platform
CURSOR_LENGTH=100

DOCS_TO_BE_PROCESSED=100
COLLECTION='entities'

# variables related to chromadb
CHROMA_HOST=chromadb
CHROMA_PORT=8000
DEFAULT_TENANT_ID=default-tenant

# variables related to ollama
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_LLM_MODEL=mistral-nemo
OLLAMA_BASE_URL=""
RAG_TEMPERATURE=0.0


#variables related to conversation
MESSAGE_TTL_DAYS=7

#variables related to chunker
MAX_TOKENS_CHUNKER=300
CHARS_PER_TOKEN_CHUNKER=2

#variables related to semantic enricher
TEMPERATURE=0.1
MAX_TERMS=20

#variables related to payload builder
MAX_TOKENS_PAYLOAD_BUILDER=400
CHARS_PER_TOKEN_PAYLOAD_BUILDER=3
ENABLE_ENRICHMENT=True

# variables related to reranker
DEFAULT_TOP_K=3

# variables related to vector_search
DEFAULT_N_RESULTS=10

# variables related to keycloak