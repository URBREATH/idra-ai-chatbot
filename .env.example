# variables related to application
PORT=3000
NODE_ENV=development
JWT_SECRET=<your-secret-key-change-in-production>
JWT_EXPIRES_IN=1h
ADMIN_TOKEN=<choose-admin-token>
CORS_ORIGINS=*

# ingestion sources (comma separated): mysql | mongo | mongo_nbs
#   mysql     -> Idra MySQL database (datasets + distributions)
#   mongo     -> every entity in the Orion-LD MongoDB (legacy)
#   mongo_nbs -> only the NBS case studies from the Orion-LD MongoDB
INGEST_SOURCES=mysql,mongo_nbs

# variables related to mysql (Idra-Backend database, service "db" on network idra-backend_idra_main)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=<idra-db-user>
MYSQL_PASSWORD=<idra-db-password>
MYSQL_DATABASE=idra_db
# skip datasets whose catalogue is no longer registered in the odms table
MYSQL_ONLY_REGISTERED_CATALOGUES=true
# optional whitelist of catalogue ids (odms.id), e.g. 96,110
MYSQL_NODE_IDS=
MYSQL_PREFERRED_LANGUAGE=en

# Orion-LD MongoDB used by the mongo_nbs source (defaults to MONGODB_URI)
ORION_MONGODB_URI=mongodb://mongodb-orion-SMARTERA-final:27017
ORION_MONGODB_DB=orion

# observability: Langfuse (self-hosted, see observability/langfuse/)
# Tracing is enabled only when both keys are set.
LANGFUSE_PUBLIC_KEY=<pk-lf-...>
LANGFUSE_SECRET_KEY=<sk-lf-...>
LANGFUSE_BASE_URL=http://langfuse-web:3000
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=1.0.0
LANGFUSE_SAMPLE_RATE=1.0
# false = do not send prompts/answers/documents, only metrics and metadata
LANGFUSE_CAPTURE_IO=true
LANGFUSE_MAX_IO_CHARS=20000
# one trace per indexed entity (false = only the run-level trace)
LANGFUSE_TRACE_INGESTION_ENTITIES=true
# Pricing is read from model_pricing.yaml (editable by an operator, hot reload).
# The env variables below are only a legacy fallback when the file is absent.
MODEL_PRICING_FILE=
LLM_INPUT_COST_PER_1K=0
LLM_OUTPUT_COST_PER_1K=0
EMBEDDING_COST_PER_1K=0

# observability: OpenTelemetry (traces/metrics/logs)
# Langfuse self-hosted receives traces directly; the generic OTLP collector
# below receives the same traces plus metrics and logs.
OTEL_ENABLED=true
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=idra-ai-chatbot-observation
OTEL_SERVICE_VERSION=1.0.0
OTEL_SERVICE_NAMESPACE=idra-collector
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_SERVICE_INSTANCE_ID=
OTEL_RESOURCE_ATTRIBUTES=deployment.platform.name=docker
# OTLP/HTTP collector. In Docker use http://host.docker.internal:4318,
# for a local process use http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# per-signal overrides (optional)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# authentication headers for the collector, e.g. "Authorization=Bearer ..."
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_TIMEOUT=10
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
# root sampling ratio (0..1); use the collector for tail sampling
OTEL_SAMPLE_RATE=1.0
# Prometheus scrape endpoint (only when OTEL_METRICS_EXPORTER=prometheus)
OTEL_PROMETHEUS_PORT=9464
# optional auto-instrumentation (packages in requirements.txt)
OTEL_INSTRUMENT_HTTPX=true
OTEL_INSTRUMENT_PYMONGO=true
OTEL_INSTRUMENT_PYMYSQL=true
# capture span input/output and redact e-mails in structured logs
OTEL_CAPTURE_IO=true
OTEL_REDACT_PII=false
# paths excluded from server spans (comma separated)
OTEL_HTTP_EXCLUDE_PATHS=
# Batching/export tuning (maximum detail, small deployment).
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_EXPORT_TIMEOUT=30000
OTEL_BLRP_SCHEDULE_DELAY=5000
OTEL_BLRP_MAX_QUEUE_SIZE=2048
OTEL_BLRP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BLRP_EXPORT_TIMEOUT=30000
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_METRIC_EXPORT_TIMEOUT=30000
# SDK limits: keep prompts/document excerpts while bounding huge payloads.
OTEL_ATTRIBUTE_COUNT_LIMIT=512
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=65535
OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT=512
OTEL_SPAN_ATTRIBUTE_VALUE_LENGTH_LIMIT=65535
OTEL_SPAN_EVENT_COUNT_LIMIT=256
OTEL_SPAN_LINK_COUNT_LIMIT=128
OTEL_LOGRECORD_ATTRIBUTE_COUNT_LIMIT=128
OTEL_LOGRECORD_ATTRIBUTE_VALUE_LENGTH_LIMIT=65535
# Capacity target for dashboards/alerts (not enforced by the app).
OTEL_MONTHLY_TOKEN_BUDGET=10000000
# Maximum application/dependency log detail.
LOG_LEVEL=DEBUG

# variables related to mongodb
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=rag_platform
CURSOR_LENGTH=<choose-how-many-entities-to-process>

DOCS_TO_BE_PROCESSED=<choose-how-many-entities-to-process>
COLLECTION=<collection-name>

# variables related to chromadb
CHROMA_HOST=chromadb
CHROMA_PORT=8000
DEFAULT_TENANT_ID=<first-tenant-name>

# variables related to ollama
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_LLM_MODEL=<qwen2.5:7b>
OLLAMA_BASE_URL=""
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096
# retry on transient Ollama errors (5xx / connection): attempts and linear backoff seconds
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_BACKOFF=2.0


#variables related to conversation
MESSAGE_TTL_DAYS=<int-related-to-automatic-message-deletion>
TOP_K=<int-related-to-best-k-results>

# variables related to reranker
DEFAULT_TOP_K=3

# variables related to vector_search
DEFAULT_N_RESULTS=10
MAX_N_RESULTS=100

# variables related to keycloak
