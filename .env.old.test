# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Il container si chiama "mongo" nella rete Docker interna
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=orion
COLLECTION=entities
# Numero massimo di documenti restituiti per singola query (aumenta se hai molte entità)
CURSOR_LENGTH=500

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
DEFAULT_TENANT_ID=default-tenant

# ─── Ollama (installazione sull'HOST, non container) ──────────────────────────
# Su Windows/macOS con Docker Desktop, host.docker.internal risolve l'indirizzo dell'host
# Su Linux aggiungere extra_hosts: ["host.docker.internal:host-gateway"] al servizio app in compose
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434
OLLAMA_BASE_URL=
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_LLM_MODEL=mixtral
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=2048

# ─── Autenticazione ───────────────────────────────────────────────────────────
JWT_SECRET=11d8e457cd4638da0ec311afa1e2541dc9a795039a2e76940b52660eb375c689
JWT_EXPIRES_IN=1h
# ADMIN_TOKEN è un token plain-text (NON un JWT) per gli endpoint /admin/*
ADMIN_TOKEN=12412112194c4c3dbd9dfae2a802691add23fbac3bfc1031383b10ea29487897

# ─── Conversazione e retrieval ────────────────────────────────────────────────
MESSAGE_TTL_DAYS=7
TOP_K=5
DEFAULT_TOP_K=3
DEFAULT_N_RESULTS=10

# ─── Limiti di contesto LLM (calibrati per modello ~30B, finestra 32.768 token) ──
# MAX_RESOURCES: numero massimo di risorse NBS passate al modello
MAX_RESOURCES=8
# MAX_DATASETS: numero massimo di dataset passati al modello
MAX_DATASETS=12
# MAX_DOC_CHARS: caratteri massimi per singola risorsa nel contesto (~500 token per risorsa)
MAX_DOC_CHARS=2000
# MAX_HISTORY_CHARS: caratteri massimi di cronologia conversazione iniettati nel prompt (~1500 token)
MAX_HISTORY_CHARS=6000
